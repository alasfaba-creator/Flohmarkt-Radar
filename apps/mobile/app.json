{
  "expo": {
    "name": "FlohmarktRadar",
    "slug": "flohmarkt-radar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "flohmarktradar",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FlohmarktRadar nutzt deinen Standort, um Flohmärkte in deiner Nähe zu zeigen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FlohmarktRadar braucht Zugriff auf deine Fotos für das Beweis-Foto deines Garagen- oder Hofflohmarkts.",
          "cameraPermission": "FlohmarktRadar braucht die Kamera für das Beweis-Foto deines Garagen- oder Hofflohmarkts."
        }
      ]
    ]
  }
}
